<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/home_title"
        android:textColor="@color/brand_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/home_subtitle"
        android:textColor="@color/brand_subtext"
        android:textSize="14sp" />

    <Button
        android:id="@+id/studentsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/brand_primary"
        android:text="@string/students"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/classButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/brand_primary"
        android:text="@string/class_label"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/callButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/brand_primary"
        android:text="@string/call_label"
        android:textAllCaps="false" />
</LinearLayout>